{
  "manifest_version": 3,
  "name": "Popup as Tab",
  "version": "1.1.0",
  "description": "Popup as Tab converts popup windows into regular tabs in your current browser window.",
  "permissions": ["alarms", "storage", "tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128-sized.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-tab-at-end": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Open a new tab at the end of the current window"
    }
  },
  "action": {
    "default_title": "Popup as Tab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
