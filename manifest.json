{
  "manifest_version": 3,
  "name": "Popup as Tab",
  "version": "1.0.0",
  "description": "Move new popup windows into the current browser window as tabs.",
  "permissions": ["alarms", "storage", "tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128-sized.png"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "Popup as Tab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
